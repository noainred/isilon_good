# isilon_usage 글로벌 통합 포탈(HQ)을 systemd 서비스로 — '스캐너'와 분리 운영.
#
# 핵심: 포탈과 스캐너는 별도 프로세스다. 코드 디렉터리/데이터/포트를 분리해 두면
# 포탈을 업그레이드·재시작해도 HQ 로컬 디스크 스캔(serve)은 전혀 영향받지 않는다.
#
# 설치:
#   1) /etc/systemd/system/isilon-portal.service 로 복사
#   2) (선택) 경로/포트 수정 — 기본값(WorkingDirectory=/opt/isilon_edge,
#      data-dir /var/lib/isilon_portal, :8800)이면 간단 설치에서 그대로 동작한다
#   3) sudo systemctl daemon-reload
#   4) sudo systemctl enable --now isilon-portal
#   5) 로그:  journalctl -u isilon-portal -f
#
# 자세한 안내: docs/SERVICE.md (HQ 분리 운영 절)

[Unit]
Description=Isilon 글로벌 통합 포탈 (HQ) — 여러 DC 집계
Documentation=https://github.com/noainred/isilon_good
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# (선택) 전용 계정
#User=isilon
#Group=isilon

# 코드 디렉터리 — 여기에 isilon_usage/ 패키지가 있어야 한다(python3 -m isilon_usage).
# 기본은 스캐너와 동일한 /opt/isilon_edge (간단 설치: 한 디렉터리 공유 → 바로 동작).
# [업그레이드 격리] 포탈만 따로 교체하려면 /opt/isilon_portal 을 만들어 패키지를
#   복사한 뒤 이 값을 /opt/isilon_portal 로 바꾼다(docs/SERVICE.md 참고).
#   주의: 지정한 디렉터리가 없으면 systemd 가 status=200/CHDIR 로 기동 실패한다.
WorkingDirectory=/opt/isilon_edge

# 포탈 데이터·설정(portal_nodes.json + replicas/) — 스캐너와 동일한 기본 위치
# /data/isilon_usage 에 저장(업그레이드 시 설정 보존). 앱이 자동 생성한다.
# 파일명이 겹치지 않아 스캐너와 한 디렉터리를 공유해도 안전하다.

# 포탈 실행 — 스캐너와 '다른 포트'(8800).
ExecStart=/usr/bin/python3 -m isilon_usage portal \
    --data-dir /data/isilon_usage \
    --host 0.0.0.0 --port 8800

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
