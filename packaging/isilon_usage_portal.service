# isilon_usage 글로벌 통합 포탈(HQ)을 systemd 서비스로 — '스캐너'와 분리 운영.
#
# 핵심: 포탈과 스캐너는 별도 프로세스다. 코드 디렉터리/데이터/포트를 분리해 두면
# 포탈을 업그레이드·재시작해도 HQ 로컬 디스크 스캔(serve)은 전혀 영향받지 않는다.
#
# 설치:
#   1) /etc/systemd/system/isilon_usage_portal.service 로 복사
#   2) 아래 <경로/포트>를 환경에 맞게 수정 (스캐너와 '다른' 디렉터리·data-dir 로)
#   3) sudo systemctl daemon-reload
#   4) sudo systemctl enable --now isilon_usage_portal
#   5) 로그:  journalctl -u isilon_usage_portal -f
#
# 자세한 안내: docs/SERVICE.md (HQ 분리 운영 절)

[Unit]
Description=Isilon 글로벌 통합 포탈 (HQ) — 여러 DC 집계
Documentation=https://github.com/noainred/isilon_good
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# (선택) 전용 계정
#User=isilon
#Group=isilon

# 포탈 '전용' 코드 디렉터리 — 스캐너(serve)와 분리한다.
# 여기엔 isilon_usage/ 패키지가 들어 있어야 한다(스캐너와 다른 위치).
WorkingDirectory=/opt/isilon_portal

# 포탈 데이터(portal_nodes.json + replicas/) — 스캐너 data-dir 와 분리.
StateDirectory=isilon_portal

# 포탈 실행 — 스캐너와 '다른 포트'(8800).
ExecStart=/usr/bin/python3 -m isilon_usage portal \
    --data-dir /var/lib/isilon_portal \
    --host 0.0.0.0 --port 8800

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
